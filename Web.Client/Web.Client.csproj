<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="GlobalUsings.cs" />
    <Content Include="Program.cs" />
    <Content Include="Properties\launchSettings.json" />
    <Content Include="Styles\app.scss" />
    <Folder Include="wwwroot\css\" />
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="beauo" Version="0.1.0-preview.beta.48" />
	  <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
	  <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
	  <PackageReference Include="AspNetCore.SassCompiler" Version="1.105.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
	  <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>
</Project>
